# ==============================================================================
# Rig Digital Twin Core - Environment Configuration
# ==============================================================================
# Copy this file to .env and customize values for your operational environment:
#   cp .env.example .env

# --- Database / TimescaleDB Configuration ---
DATABASE_URL=postgresql://rig_admin:rig_password@localhost:5432/rig_digital_twin
POSTGRES_USER=rig_admin
POSTGRES_PASSWORD=rig_password
POSTGRES_DB=rig_digital_twin
POSTGRES_PORT=5432

# --- FastAPI REST & WebSocket Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=false
CORS_ORIGINS=["*"]

# --- WITS Level 0 TCP Server ---
WITS0_HOST=0.0.0.0
WITS0_PORT=9090

# --- Twin Physics Engine Tuning ---
PHYSICS_DISCRETIZATION_CELL_FT=100.0
AUTO_CALIBRATION_INTERVAL_SEC=30
DYNAMIC_SURGE_SWAB_ENABLED=true
THERMAL_PVT_ENABLED=true

# --- Anomaly Detection & Statistical Residuals ---
CUSUM_DRIFT_ALLOWANCE_K=0.5
CUSUM_DECISION_THRESHOLD_H=4.5
KALMAN_PROCESS_NOISE_Q=0.05
KALMAN_MEASUREMENT_NOISE_R=1.5

# --- Logging & Telemetry Level ---
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true
